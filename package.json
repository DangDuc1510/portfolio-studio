{
  "name": "portfolio-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Studio Monorepo",
  "workspaces": [
    "portfolio-web",
    "portfolio-backend"
  ],
  "scripts": {
    "dev:web": "cd portfolio-web && npm run dev",
    "dev:backend": "cd portfolio-backend && npm run dev",
    "dev": "npm run dev:backend & npm run dev:web",
    "build:web": "cd portfolio-web && npm run build",
    "build:backend": "cd portfolio-backend && npm run build",
    "install:all": "npm install && cd portfolio-web && npm install && cd ../portfolio-backend && npm install"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
